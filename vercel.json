{
  "redirects": [
    {
      "source": "/.well-known/security",
      "destination": "/.well-known/security.txt",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/.well-known/security.txt",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
